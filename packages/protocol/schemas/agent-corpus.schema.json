{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hatch.dev/agent/agent-corpus.schema.json",
  "title": "Hatch Agent Corpus v1",
  "description": "A runtime-free, publishable definition of one current Creator Agent. It contains global instructions, optional local Skills, retrieval-only knowledge, declared tools, and non-runtime evaluation assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "agent_id",
    "creator",
    "product",
    "instructions",
    "knowledge",
    "tools",
    "evaluations"
  ],
  "properties": {
    "contract_version": { "const": "1" },
    "agent_id": { "$ref": "#/$defs/identifier" },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "promise": { "type": "string", "minLength": 1 },
        "inputs": { "$ref": "#/$defs/nonEmptyStrings" },
        "outputs": { "$ref": "#/$defs/nonEmptyStrings" },
        "boundaries": { "$ref": "#/$defs/nonEmptyStrings" },
        "offer": { "$ref": "#/$defs/offer" }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Always-loaded global worldview, voice, values, product boundaries, and global canonical examples. This is not retrievable knowledge.",
      "required": ["system"],
      "properties": {
        "system": { "$ref": "#/$defs/systemInstruction" }
      }
    },
    "skills": {
      "type": "array",
      "description": "Optional local execution units. Omit or use [] when the Agent needs no independently reusable local execution unit.",
      "items": { "$ref": "#/$defs/skill" }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "description": "The Agent-scoped retrieval namespace. Documents are retrieval-only long-tail material and may be empty; they must not contain global instructions, Skill instructions, references, canonical few-shots, or held-out evaluations.",
      "required": ["documents"],
      "properties": {
        "documents": {
          "type": "array",
          "items": { "$ref": "#/$defs/knowledgeDocument" }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 2,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "id": { "const": "hatch.web_search" } },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": { "id": { "const": "hatch.file_search" } },
            "required": ["id"]
          }
        }
      ],
      "items": { "$ref": "#/$defs/tool" },
      "description": "Declarative capabilities only. No endpoint, provider credential, or secret belongs in a Corpus. Hatch-owned web and file search are always required."
    },
    "evaluations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Generated evaluation assets. They validate the Agent and never become automatic Runtime context.",
      "required": ["synthetic_qa", "held_out"],
      "properties": {
        "synthetic_qa": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evaluationAsset" }
        },
        "held_out": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evaluationAsset" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/digest" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "systemInstruction": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "path": { "type": "string", "const": "instructions/system.md" } } }
      ]
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "unit"],
      "properties": {
        "model": { "type": "string", "enum": ["per_delivery", "subscription"] },
        "unit": { "type": "string", "minLength": 1 },
        "amount_minor": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "allOf": [
        {
          "if": { "required": ["amount_minor"] },
          "then": { "required": ["currency"] }
        },
        {
          "if": { "required": ["currency"] },
          "then": { "required": ["amount_minor"] }
        }
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "when_to_use", "instruction"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "when_to_use": { "type": "string", "minLength": 1 },
        "instruction": {
          "allOf": [
            { "$ref": "#/$defs/asset" },
            { "type": "object", "properties": { "path": { "type": "string", "pattern": "^skills/[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*/SKILL\\.md$" } } }
          ]
        },
        "references": {
          "type": "array",
          "description": "Optional local method, style, or example files. They are loaded only with this Skill and are never RAG documents.",
          "items": { "$ref": "#/$defs/skillReference" }
        },
        "allowed_tool_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolIdentifier" }
        }
      }
    },
    "skillReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "kind"],
      "properties": {
        "asset": {
          "allOf": [
            { "$ref": "#/$defs/asset" },
            { "type": "object", "properties": { "path": { "type": "string", "pattern": "^skills/[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*/references/[A-Za-z0-9][A-Za-z0-9._-]*\\.md$" } } }
          ]
        },
        "kind": { "type": "string", "enum": ["method", "style", "example", "few_shots"] }
      }
    },
    "knowledgeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "retrieval_only", "source_summary"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string", "pattern": "^knowledge/[A-Za-z0-9][A-Za-z0-9._/-]*\\.md$" },
        "sha256": { "$ref": "#/$defs/digest" },
        "description": { "type": "string", "minLength": 1 },
        "retrieval_only": { "const": true },
        "source_summary": { "type": "string", "minLength": 1 }
      }
    },
    "toolIdentifier": {
      "type": "string",
      "pattern": "^(?:hatch|creator)\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "tool": {
      "oneOf": [
        { "$ref": "#/$defs/hatchWebSearch" },
        { "$ref": "#/$defs/hatchFileSearch" },
        { "$ref": "#/$defs/hatchLocalTool" },
        { "$ref": "#/$defs/creatorHttpTool" },
        { "$ref": "#/$defs/creatorMcpTool" }
      ]
    },
    "hatchWebSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "capability"],
      "properties": {
        "id": { "const": "hatch.web_search" },
        "kind": { "const": "hatch_builtin" },
        "capability": { "const": "web_search" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "hatchFileSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "capability"],
      "properties": {
        "id": { "const": "hatch.file_search" },
        "kind": { "const": "hatch_builtin" },
        "capability": { "const": "file_search" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "hatchLocalTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "capability"],
      "properties": {
        "id": { "type": "string", "pattern": "^hatch\\.local\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
        "kind": { "const": "local_harness" },
        "capability": { "type": "string", "enum": ["filesystem", "shell", "git"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "creatorHttpTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "connection_ref", "operation"],
      "properties": {
        "id": { "type": "string", "pattern": "^creator\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
        "kind": { "const": "http_function" },
        "connection_ref": { "$ref": "#/$defs/identifier" },
        "operation": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "input_schema": { "type": "object" }
      }
    },
    "creatorMcpTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "connection_ref", "tool_name"],
      "properties": {
        "id": { "type": "string", "pattern": "^creator\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
        "kind": { "const": "mcp_tool" },
        "connection_ref": { "$ref": "#/$defs/identifier" },
        "tool_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "input_schema": { "type": "object" }
      }
    },
    "evaluationAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "path": { "type": "string", "pattern": "^evals/[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$" } } }
      ]
    }
  }
}
