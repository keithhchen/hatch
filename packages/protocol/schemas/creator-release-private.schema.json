{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hatch.dev/release/creator-release-private-v1.schema.json",
  "title": "Hatch Creator Release Server-Private Contract v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "release_id", "product_id", "creator_id", "version", "digest", "system_prompt", "protected_skills", "rag", "few_shots", "runtime_policy"],
  "properties": {
    "contract_version": { "const": "1" }, "release_id": { "type": "string", "minLength": 1 }, "product_id": { "type": "string", "minLength": 1 },
    "creator_id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" },
    "system_prompt": { "type": "string", "minLength": 1 },
    "protected_skills": { "$ref": "#/$defs/assetCollection" },
    "rag": { "type": "object", "additionalProperties": false, "required": ["root", "documents"], "properties": { "root": { "type": "string", "minLength": 1 }, "documents": { "type": "array", "items": { "$ref": "#/$defs/asset" } } } },
    "few_shots": { "type": "array", "items": { "type": "object" } },
    "runtime_policy": {
      "type": "object",
      "required": ["delivery_workflow"],
      "properties": {
        "delivery_workflow": { "$ref": "#/$defs/deliveryWorkflow" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "asset": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/digest" }, "provenance": { "type": "string", "minLength": 1 } } },
    "assetCollection": { "type": "object", "additionalProperties": false, "required": ["root", "assets"], "properties": { "root": { "type": "string", "minLength": 1 }, "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } } } },
    "deliveryWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "mode", "audit", "audit_instruction", "revision_instruction", "audit_result_format", "max_revision_passes", "on_unresolved", "expose_intermediate"],
      "properties": {
        "version": { "const": "1" },
        "mode": { "const": "draft_claim_audit_revise" },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "verdicts", "require_evidence_entailment", "check_product_boundaries", "coverage", "evidence_authority"],
          "properties": {
            "unit": { "const": "atomic_claim" },
            "verdicts": { "type": "array", "minItems": 5, "items": { "enum": ["entailed", "unsupported", "conflicting", "confidential", "out_of_scope"] } },
            "require_evidence_entailment": { "const": true },
            "check_product_boundaries": { "const": true },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unitization", "require_all_units", "max_units"],
              "properties": {
                "unitization": { "const": "markdown_claim_clauses_v1" },
                "require_all_units": { "const": true },
                "max_units": { "type": "integer", "minimum": 1, "maximum": 500 }
              }
            },
            "evidence_authority": {
              "type": "object",
              "additionalProperties": false,
              "required": ["user_fact_sources", "creator_method_sources", "protected_knowledge_cannot_support_user_specific_claims"],
              "properties": {
                "user_fact_sources": { "const": ["user_input", "approved_tool_evidence"] },
                "creator_method_sources": { "const": ["protected_knowledge"] },
                "protected_knowledge_cannot_support_user_specific_claims": { "const": true }
              }
            }
          }
        },
        "audit_instruction": { "type": "string", "minLength": 1 },
        "revision_instruction": { "type": "string", "minLength": 1 },
        "audit_result_format": { "type": "object" },
        "max_revision_passes": { "type": "integer", "minimum": 1, "maximum": 3 },
        "on_unresolved": { "const": "return_boundary_safe_partial" },
        "expose_intermediate": { "const": false }
      }
    }
  }
}
