{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hatch.dev/agent/creator-agent-v1.schema.json",
  "title": "Hatch Creator Agent v1",
  "description": "The self-contained canonical contract for one runtime-free Hatch Agent Corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "creator", "product", "instructions", "tools", "evaluations"],
  "properties": {
    "contract_version": { "const": "1" },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/uuidV4" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/uuidV4" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "promise": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "boundaries": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "presentation": { "type": "object", "maxProperties": 128, "additionalProperties": true }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system"],
      "properties": {
        "system": { "$ref": "#/$defs/systemInstruction" }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/skill" }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents"],
      "properties": {
        "documents": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/knowledgeDocument" }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "contains": {
        "type": "object",
        "properties": { "id": { "const": "hatch.web_search" } },
        "required": ["id"]
      },
      "items": { "$ref": "#/$defs/tool" }
    },
    "evaluations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_qa", "held_out"],
      "properties": {
        "synthetic_qa": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/evaluationAsset" } },
        "held_out": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/evaluationAsset" } }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$", "minLength": 1, "maxLength": 128 },
    "uuidV4": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/digest" },
        "description": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "relativePath": { "type": "string", "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "systemInstruction": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "path": { "const": "instructions/system.md" } } }
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "when_to_use", "instruction"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "when_to_use": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "instruction": {
          "allOf": [
            { "$ref": "#/$defs/asset" },
            { "type": "object", "properties": { "path": { "type": "string", "pattern": "^skills/[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*/SKILL\\.md$" } } }
          ]
        },
        "references": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/skillReference" } },
        "allowed_tool_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/toolIdentifier" } }
      }
    },
    "skillReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "kind"],
      "properties": {
        "asset": {
          "allOf": [
            { "$ref": "#/$defs/asset" },
            { "type": "object", "properties": { "path": { "type": "string", "pattern": "^skills/[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*/references/[A-Za-z0-9][A-Za-z0-9._-]*\\.md$" } } }
          ]
        },
        "kind": { "type": "string", "enum": ["method", "style", "example", "few_shots"] }
      }
    },
    "knowledgeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "retrieval_only", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string", "pattern": "^knowledge/[A-Za-z0-9][A-Za-z0-9._/-]*\\.md$" },
        "sha256": { "$ref": "#/$defs/digest" },
        "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "retrieval_only": { "const": true },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "toolIdentifier": { "type": "string", "maxLength": 256, "pattern": "^(?:hatch|creator)\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "tool": {
      "oneOf": [
        { "$ref": "#/$defs/hatchWebSearch" },
        { "$ref": "#/$defs/hatchFileSearch" },
        { "$ref": "#/$defs/hatchLocalTool" },
        { "$ref": "#/$defs/creatorHttpTool" },
        { "$ref": "#/$defs/creatorMcpTool" }
      ]
    },
    "hatchWebSearch": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "capability"],
      "properties": { "id": { "const": "hatch.web_search" }, "kind": { "const": "hatch_builtin" }, "capability": { "const": "web_search" }, "description": { "type": "string", "minLength": 1, "maxLength": 4096 } }
    },
    "hatchFileSearch": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "capability"],
      "properties": { "id": { "const": "hatch.file_search" }, "kind": { "const": "hatch_builtin" }, "capability": { "const": "file_search" }, "description": { "type": "string", "minLength": 1, "maxLength": 4096 } }
    },
    "hatchLocalTool": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "capability"],
      "properties": { "id": { "type": "string", "maxLength": 256, "pattern": "^hatch\\.local\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" }, "kind": { "const": "local_harness" }, "capability": { "type": "string", "enum": ["filesystem", "shell", "git"] }, "description": { "type": "string", "minLength": 1, "maxLength": 4096 } }
    },
    "creatorHttpTool": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "connection_ref", "operation"],
      "properties": { "id": { "type": "string", "maxLength": 256, "pattern": "^creator\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" }, "kind": { "const": "http_function" }, "connection_ref": { "$ref": "#/$defs/identifier" }, "operation": { "type": "string", "minLength": 1, "maxLength": 256 }, "description": { "type": "string", "minLength": 1, "maxLength": 4096 }, "input_schema": { "type": "object", "maxProperties": 128 } }
    },
    "creatorMcpTool": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "connection_ref", "tool_name"],
      "properties": { "id": { "type": "string", "maxLength": 256, "pattern": "^creator\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" }, "kind": { "const": "mcp_tool" }, "connection_ref": { "$ref": "#/$defs/identifier" }, "tool_name": { "type": "string", "minLength": 1, "maxLength": 256 }, "description": { "type": "string", "minLength": 1, "maxLength": 4096 }, "input_schema": { "type": "object", "maxProperties": 128 } }
    },
    "evaluationAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "path": { "type": "string", "pattern": "^evals/[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$" } } }
      ]
    }
  }
}
