{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hatch.dev/release/creator-release-public-v1.schema.json",
  "title": "Hatch Creator Release Public Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "release_id", "product_id", "creator_id", "version", "digest", "creator", "product", "presentation"],
  "properties": {
    "contract_version": { "const": "1" },
    "release_id": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "creator_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "digest": { "$ref": "#/$defs/digest" },
    "creator": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "promise", "boundaries", "price", "supported_local_capabilities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 },
        "promise": { "type": "string", "minLength": 1 }, "boundaries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "price": { "type": "object", "additionalProperties": false, "required": ["amount_minor", "currency"], "properties": { "model": { "type": "string", "enum": ["per_delivery", "subscription"] }, "amount_minor": { "type": "integer", "minimum": 0 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "unit": { "type": "string", "minLength": 1 } } },
        "supported_local_capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "presentation": { "type": "object", "additionalProperties": true }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
