{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["outputs"],
  "properties": {
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "response"],
        "properties": {
          "id": { "type": "string" },
          "response": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
