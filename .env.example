# Hatch MVP

# Hatch v1 uses one model contract end to end. Candidate generation,
# delivery audit, blind judging, Runtime turns, and compaction all run on
# Moonshot's Kimi 2.6; there is no silent provider/model fallback.
LLM_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.cn/v1
HATCH_LLM_TIMEOUT_MS=120000
HATCH_MAX_OUTPUT_TOKENS=1024
HATCH_CREATOR_MODEL=kimi-k2.6
HATCH_REVIEWER_MODEL=kimi-k2.6
HATCH_COMPACTION_MODEL=kimi-k2.6

# Consumer Desktop always connects to the cloud Runtime. Local development
# does not start a second Runtime process.
VITE_HATCH_RUNTIME_URL=wss://hatch.tokenquadrant.cn/v1/runtime
VITE_HATCH_AUTH_URL=https://hatch.tokenquadrant.cn
VITE_HATCH_ACCOUNT_ID=
VITE_HATCH_ACCOUNT_ROLE=user
VITE_HATCH_DISPLAY_NAME=
VITE_HATCH_AUTH_TOKEN=
HATCH_AUTH_SIGNING_SECRET=
HATCH_RELEASES_DIR=
HATCH_ENTITLEMENTS_FILE=
HATCH_COMMERCE_LEDGER_FILE=
HATCH_LOCAL_ROOT=./.hatch-local
HATCH_DOMAIN=hatch.tokenquadrant.cn
POSTGRES_DB=hatch
POSTGRES_USER=hatch
POSTGRES_PASSWORD=
HATCH_REGISTRY_DATABASE_URL=postgresql://hatch:change-me@postgres:5432/hatch
HATCH_REGISTRY_RUNTIME_SERVICE_TOKEN=
HATCH_AGENT_CORPUS_ROOT=/var/lib/hatch/corpora

# Import completed Factory outputs with creator-dashboard's catalog:import
# command. The running Dashboard reads only this clean, Dashboard-owned file.
HATCH_CREATOR_PRODUCT_CATALOG_PATH=
HATCH_CREATOR_RELEASE_ROOT=
HATCH_CREATOR_DASHBOARD_FIXTURE_PATH=
HATCH_CREATOR_PRODUCT_STATE_PATH=
HATCH_COMMERCE_LEDGER_PATH=
# Creator Factory publish target. Registry is cloud-owned.
HATCH_REGISTRY_URL=https://hatch.tokenquadrant.cn
HATCH_REGISTRY_PUBLISH_SERVICE_TOKEN=
REGISTRY_PORT=8100
REGISTRY_HOST=127.0.0.1

# Self-hosted Qdrant RAG (knowledge/*.md only)
HATCH_QDRANT_URL=http://127.0.0.1:6333
HATCH_QDRANT_API_KEY=
HATCH_QDRANT_COLLECTION=hatch_knowledge_text_v4_1024
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
