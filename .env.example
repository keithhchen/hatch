# Hatch MVP

# Hatch uses Moonshot's Kimi 2.6 for Factory, Runtime, and compaction.
# There is no silent provider/model fallback.
MOONSHOT_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.cn/v1
HATCH_CREATOR_MODEL=kimi-k2.6
HATCH_COMPACTION_MODEL=kimi-k2.6

VITE_HATCH_RUNTIME_URL=ws://127.0.0.1:8400/runtime
VITE_HATCH_USER_ID=
VITE_HATCH_USER_NAME=
VITE_HATCH_ACCESS_TOKEN=
HATCH_AGENT_CORPUS_ROOT=
HATCH_AGENT_KNOWLEDGE_ROOT=
HATCH_ENTITLEMENTS_FILE=
HATCH_COMMERCE_LEDGER_FILE=
HATCH_LOCAL_ROOT=./.hatch-local

HATCH_COMMERCE_LEDGER_PATH=
HATCH_REGISTRY_URL=http://127.0.0.1:8100
# Internal Factory → Registry publisher credential. It never enters a Corpus.
HATCH_REGISTRY_PUBLISH_SERVICE_TOKEN=
# Internal Runtime → Registry credential for Agent-scoped RAG and Creator tool
# resolution. In the initial single-service deployment this may be the same
# service credential as the Registry publisher; it never enters a Corpus.
HATCH_REGISTRY_RUNTIME_SERVICE_TOKEN=
# Registry-only managed RAG configuration. Do not put it in runtime-server/.env
# or an Agent Corpus. The Registry uses Bailian only for retrieval/embedding;
# Kimi remains the only model used by Factory and Runtime. In production, the
# Registry runs on ECS with a RAM Role; no AccessKey is configured. The AK/SK
# pair below is only for local development outside ECS.
HATCH_BAILIAN_WORKSPACE_ID=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
HATCH_BAILIAN_RAG_STATE_PATH=/var/lib/hatch/bailian-rag-state.json
