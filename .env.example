# Hatch MVP

# Hatch v1 uses one model contract end to end. Candidate generation,
# delivery audit, blind judging, Runtime turns, and compaction all run on
# Moonshot's Kimi 2.6; there is no silent provider/model fallback.
MOONSHOT_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.cn/v1
HATCH_CREATOR_MODEL=kimi-k2.6
HATCH_REVIEWER_MODEL=kimi-k2.6
HATCH_COMPACTION_MODEL=kimi-k2.6

VITE_HATCH_RUNTIME_URL=ws://127.0.0.1:8400/runtime
VITE_HATCH_USER_ID=
VITE_HATCH_USER_NAME=
VITE_HATCH_ACCESS_TOKEN=
HATCH_RELEASES_DIR=
HATCH_ENTITLEMENTS_FILE=
HATCH_COMMERCE_LEDGER_FILE=
HATCH_LOCAL_ROOT=./.hatch-local

# Import completed Factory outputs with creator-dashboard's catalog:import
# command. The running Dashboard reads only this clean, Dashboard-owned file.
HATCH_CREATOR_PRODUCT_CATALOG_PATH=
HATCH_CREATOR_RELEASE_ROOT=
HATCH_CREATOR_DASHBOARD_FIXTURE_PATH=
HATCH_CREATOR_PRODUCT_STATE_PATH=
HATCH_COMMERCE_LEDGER_PATH=
HATCH_REGISTRY_URL=http://127.0.0.1:8100
HATCH_REGISTRY_PUBLISH_SERVICE_TOKEN=
