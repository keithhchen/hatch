# The previously published Dashboard image (CI passes it; `scratch` when there is none). Its assets stay servable so a tab
# opened before a deploy, or a request that lands on the old container during a rolling deploy, still finds its chunks.
ARG PREVIOUS_DASHBOARD_IMAGE=scratch
FROM ${PREVIOUS_DASHBOARD_IMAGE} AS previous

FROM node:22-slim AS build

# sentry-cli (source map upload) uses the system trust store, which the slim image does not ship.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/creator-dashboard
COPY packages/ui /workspace/packages/ui
COPY packages/brand /workspace/packages/brand
COPY packages/chat /workspace/packages/chat
RUN cd /workspace/packages/ui && npm ci
RUN cd /workspace/packages/chat && npm ci
COPY creator-dashboard/package.json creator-dashboard/package-lock.json ./
RUN npm ci
COPY creator-dashboard ./
COPY packages/commerce /workspace/packages/commerce
ARG VITE_HATCH_DESKTOP_DOWNLOAD_BASE_URL
ENV VITE_HATCH_DESKTOP_DOWNLOAD_BASE_URL=${VITE_HATCH_DESKTOP_DOWNLOAD_BASE_URL}
ARG VITE_HATCH_WEB_MEDIA_BASE_URL
ENV VITE_HATCH_WEB_MEDIA_BASE_URL=${VITE_HATCH_WEB_MEDIA_BASE_URL}
ARG VITE_SENTRY_DSN
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
ARG VITE_RELEASE
ENV VITE_RELEASE=${VITE_RELEASE}
# Source maps are never served: the publish build uploads them to Sentry with a BuildKit secret (never an ARG/ENV), then they are deleted.
RUN --mount=type=secret,id=sentry_auth_token \
  SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token 2>/dev/null)" npm run build \
  && find dist -name "*.map" -delete \
  && if [ -n "$VITE_HATCH_WEB_MEDIA_BASE_URL" ]; then \
    rm -f dist/assets/web/*.mp4 public/assets/web/*.mp4; \
  fi

# The CLI ships as a tarball served at /downloads/hatch-cli.tgz (no npm registry).
COPY packages/hatch-cli /workspace/packages/hatch-cli
RUN mkdir -p dist/downloads \
  && cd /workspace/packages/hatch-cli \
  && npm pack --silent --pack-destination /workspace/creator-dashboard/dist/downloads \
  && mv /workspace/creator-dashboard/dist/downloads/*.tgz /workspace/creator-dashboard/dist/downloads/hatch-cli.tgz

# Add only the previous release's own assets (never overwrite a new file, never the releases before it) to this release.
FROM build AS release
WORKDIR /workspace/creator-dashboard
RUN --mount=type=bind,from=previous,source=/,target=/previous \
  (cd dist/assets && find . -type f | sort) > own-assets.txt \
  && prev=/previous/app/creator-dashboard \
  && if [ ! -d "$prev/dist/assets" ]; then echo "No previous Dashboard assets to carry"; \
     else \
       list="$prev/own-assets.txt"; \
       if [ ! -f "$list" ]; then list=/tmp/previous-assets.txt; (cd "$prev/dist/assets" && find . -type f | sort) > "$list"; fi; \
       grep -vxFf own-assets.txt "$list" > /tmp/carry.txt || true; \
       (cd "$prev/dist/assets" && xargs -a /tmp/carry.txt -r cp -a --parents -t /workspace/creator-dashboard/dist/assets); \
       echo "Carried $(wc -l < /tmp/carry.txt) previous assets"; \
     fi

FROM node:22-slim AS production

ENV NODE_ENV=production
# The server writes the Help videos' public URLs into its JSON-LD; same value the browser bundle was built with.
ARG VITE_HATCH_WEB_MEDIA_BASE_URL
ENV HATCH_WEB_MEDIA_BASE_URL=${VITE_HATCH_WEB_MEDIA_BASE_URL}
WORKDIR /app/creator-dashboard

COPY packages/ui /app/packages/ui
COPY packages/brand /app/packages/brand
COPY packages/chat /app/packages/chat
COPY creator-dashboard/package.json creator-dashboard/package-lock.json ./
RUN npm ci --omit=dev
# Every server module ships: a new .mjs the server imports must never be left out of the image.
COPY --from=build /workspace/creator-dashboard/*.mjs ./
# The production server imports its own .mjs modules and serves the bundled
# browser output. Keep tests, stories, and client source out of the runtime
# image; they are built and verified in the Web CI job above.
COPY --from=release /workspace/creator-dashboard/dist ./dist
COPY --from=release /workspace/creator-dashboard/own-assets.txt ./own-assets.txt
COPY --from=build /workspace/creator-dashboard/public ./public
COPY packages/commerce /app/packages/commerce

EXPOSE 8500
CMD ["node", "server.mjs"]
