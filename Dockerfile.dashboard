FROM node:22-slim AS build

WORKDIR /workspace/creator-dashboard
COPY packages/ui /workspace/packages/ui
COPY packages/brand /workspace/packages/brand
COPY creator-dashboard/package.json creator-dashboard/package-lock.json ./
RUN npm ci
COPY creator-dashboard ./
COPY packages/commerce /workspace/packages/commerce
RUN npm run build

FROM node:22-slim AS production

ENV NODE_ENV=production
WORKDIR /app/creator-dashboard

COPY creator-dashboard/package.json creator-dashboard/package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /workspace/creator-dashboard/server.mjs ./server.mjs
COPY --from=build /workspace/creator-dashboard/portalState.mjs ./portalState.mjs
COPY --from=build /workspace/creator-dashboard/providerAdapters.mjs ./providerAdapters.mjs
COPY --from=build /workspace/creator-dashboard/publicMetadata.mjs ./publicMetadata.mjs
COPY --from=build /workspace/creator-dashboard/telemetry.mjs ./telemetry.mjs
COPY --from=build /workspace/creator-dashboard/src ./src
COPY --from=build /workspace/creator-dashboard/dist ./dist
COPY --from=build /workspace/creator-dashboard/public ./public
COPY packages/commerce /app/packages/commerce

EXPOSE 8500
CMD ["node", "server.mjs"]
