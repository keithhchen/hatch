{$HATCH_DOMAIN} {
    encode gzip

    # Public deploy probes expose readiness without opening service command
    # routes. Each backend keeps its separate private liveness endpoint.
    @runtime_health path /health/runtime
    handle @runtime_health {
        rewrite * /readyz
        reverse_proxy runtime:8400
    }

    @dashboard_health path /health/dashboard
    handle @dashboard_health {
        rewrite * /readyz
        reverse_proxy dashboard:8500
    }

    # Desktop WebSocket endpoint. The public /v1 prefix is removed before the
    # request reaches the Runtime's native /runtime WebSocket path.
    @runtime_socket path /v1/runtime*
    handle @runtime_socket {
        uri strip_prefix /v1
        reverse_proxy runtime:8400
    }

    # Desktop HTTP APIs owned by Runtime.
    @runtime_api path /v1/me/creator-agents /v1/conversations*
    handle @runtime_api {
        reverse_proxy runtime:8400
    }

    @runtime_history path /conversations/*
    handle @runtime_history {
        reverse_proxy runtime:8400
    }

    # TypeScript Registry APIs. Keep the public paths stable so Factory and
    # Desktop can use HATCH_REGISTRY_URL without knowing the private service
    # name. Dashboard-specific /v1/creator/products routes remain below.
    @registry_api path /v1/agent-corpora* /v1/catalog/agents* /v1/auth/signup /v1/auth/signin /v1/auth/me /v1/auth/logout /v1/user/agent-access /v1/creator/agents /v1/creator/agent-corpora /v1/runtime/tenants/* /v1/runtime/creators/* /v1/control-plane/connections/* /v1/creators/*
    handle @registry_api {
        reverse_proxy registry:8100
    }

    # `/v1/auth/me` and `/v1/creator/agents` are intentionally shared by the
    # Desktop/Registry API and the cookie-backed Web BFF. A Desktop call always
    # carries its opaque Authorization bearer; browser Portal calls carry only
    # the HttpOnly Web session cookie and must reach Dashboard. Routing only on
    # the path would shadow Dashboard and log the user out after every refresh.
    @registry_bearer_api {
        path /v1/auth/me /v1/creator/agents
        header Authorization *
    }
    handle @registry_bearer_api {
        reverse_proxy registry:8100
    }

    # Expose only the Registry readiness check. Never bridge a broad public
    # prefix to Registry command routes.
    @registry_health path /health/registry
    handle @registry_health {
        rewrite * /readyz
        reverse_proxy registry:8100
    }

    # Runtime accounting is an internal service-to-service API. Runtime calls
    # Dashboard on hatch_internal; never expose these commands at the edge.
    @internal_service_api path /v1/internal/commerce* /v1/internal/deployments*
    respond @internal_service_api 404

    # Creator and buyer Portal API.
    handle /v1/* {
        reverse_proxy dashboard:8500
    }

    # Stable entrypoint used by the packaged Consumer Desktop. The buyer Portal
    # opens on its Explore catalog, while keeping the Desktop allowlist narrow.
    @buyer_catalog_entry path /agents /agents/*
    redir @buyer_catalog_entry /portal/ 308

    # Vite's production base path is /portal/; the Dashboard container serves
    # the built static files and its API from the same origin.
    handle /portal* {
        reverse_proxy dashboard:8500
    }

    @root path /
    redir @root /agents 308

    handle {
        reverse_proxy dashboard:8500
    }
}
