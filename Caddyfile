{$HATCH_DOMAIN} {
    encode gzip

    # Public deploy probes expose readiness without opening service command
    # routes. Each backend keeps its separate private liveness endpoint.
    @runtime_health path /health/runtime
    handle @runtime_health {
        rewrite * /readyz
        reverse_proxy runtime:8400
    }

    @dashboard_health path /health/dashboard
    handle @dashboard_health {
        rewrite * /readyz
        reverse_proxy dashboard:8500
    }

    # Desktop WebSocket endpoint. The public /v1 prefix is removed before the
    # request reaches the Runtime's native /runtime WebSocket path.
    @runtime_socket path /v1/runtime*
    handle @runtime_socket {
        uri strip_prefix /v1
        reverse_proxy runtime:8400
    }

    # Keep the native Runtime WebSocket address shareable for Desktop clients
    # that do not use the public /v1 compatibility prefix.
    @runtime_native path /runtime*
    handle @runtime_native {
        reverse_proxy runtime:8400
    }

    # Desktop HTTP APIs owned by Runtime.
    @runtime_api path /v1/me/creator-agents /v1/conversations*
    handle @runtime_api {
        reverse_proxy runtime:8400
    }

    @runtime_history path /conversations/*
    handle @runtime_history {
        reverse_proxy runtime:8400
    }

    # Expose only the Registry readiness check. Never bridge a broad public
    # prefix to Registry command routes.
    @registry_health path /health/registry
    handle @registry_health {
        rewrite * /readyz
        reverse_proxy registry:8100
    }

    # Runtime accounting is an internal service-to-service API. Runtime calls
    # Dashboard on hatch_internal; never expose these commands at the edge.
    @internal_service_api path /v1/internal/access* /v1/internal/commerce* /v1/internal/deployments*
    respond @internal_service_api 404

    # Packaged Desktop uses an opaque Registry bearer, while the browser uses
    # the Dashboard's HttpOnly cookie session. Registry owns sign-in and
    # identity; the Dashboard owns the shared Web/Desktop entitlement view.
    @desktop_registry_signin path /v1/auth/signin
    handle @desktop_registry_signin {
        reverse_proxy registry:8100
    }
    # A WebView CORS preflight never carries the bearer itself. Route the
    # narrow Desktop endpoint preflights to the same Registry owner so the
    # browser can subsequently send the authenticated request.
    @desktop_registry_preflight {
        method OPTIONS
        path /v1/auth/me /v1/auth/logout
    }
    handle @desktop_registry_preflight {
        reverse_proxy registry:8100
    }
    @desktop_registry_bearer {
        path /v1/auth/me /v1/auth/logout
        header Authorization *
    }
    handle @desktop_registry_bearer {
        reverse_proxy registry:8100
    }

    # All browser APIs belong to the cookie-backed Dashboard BFF. In
    # particular, /v1/auth/me must not be shadowed by Registry.
    handle /v1/* {
        reverse_proxy dashboard:8500
    }

    # Static assets and all addressable public/private pages are served by the
    # Dashboard. The browser app owns auth/returnTo and private authorization.
    handle /assets/* {
        reverse_proxy dashboard:8500
    }

    handle {
        reverse_proxy dashboard:8500
    }
}
