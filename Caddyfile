# The Registry, Runtime and Dashboard each run two containers while a release replaces the old one. Resolve the
# service name again every second so both are balanced during the overlap, and retry a request the draining
# container refuses on the other. (Dynamic upstreams have no active health checks; a refused connection is the signal.)
(upstream) {
    reverse_proxy {
        dynamic a {args[0]} {args[1]} {
            refresh 1s
        }
        lb_try_duration 5s
        lb_try_interval 250ms
        fail_duration 3s
        max_fails 1
    }
}

(hatch_routes) {
    # Not the Responses API: its server-sent events must reach the client as they are written, not once a gzip buffer fills.
    @compressible not path /responses/v1/*
    encode @compressible gzip

    # One correlation id per request: keep the caller's, else mint one. Every backend reads and echoes it.
    @no_request_id not header X-Request-Id *
    request_header @no_request_id X-Request-Id {http.request.uuid}
    log {
        output stdout
        format json
    }

    # Public deploy probes expose readiness without opening service command
    # routes. Each backend keeps its separate private liveness endpoint.
    @runtime_health path /health/runtime
    handle @runtime_health {
        rewrite * /readyz
        import upstream runtime 8400
    }

    @dashboard_health path /health/dashboard
    handle @dashboard_health {
        rewrite * /readyz
        import upstream dashboard 8500
    }

    # The Registry owns the authenticated Runtime release read. Keep this
    # narrow path ahead of the broad WebSocket prefix below; otherwise Caddy
    # sends the release lookup to Runtime, which has no Registry route and
    # returns a misleading 404.
    @runtime_release path /v1/runtime/products/*/release
    handle @runtime_release {
        import upstream registry 8100
    }

    # Desktop WebSocket endpoint. The public /v1 prefix is removed before the
    # request reaches the Runtime's native /runtime WebSocket path.
    @runtime_socket path /v1/runtime*
    handle @runtime_socket {
        uri strip_prefix /v1
        import upstream runtime 8400
    }

    # Keep the native Runtime WebSocket address shareable for Desktop clients
    # that do not use the public /v1 compatibility prefix.
    @runtime_native path /runtime*
    handle @runtime_native {
        import upstream runtime 8400
    }

    # The Responses API (OpenAI-compatible: base URL https://<host>/responses/v1), owned by Runtime.
    @responses_api path /responses/v1 /responses/v1/*
    handle @responses_api {
        import upstream runtime 8400
    }

    # Desktop HTTP APIs owned by Runtime.
    @runtime_api path /v1/me/creator-agents /v1/conversations*
    handle @runtime_api {
        import upstream runtime 8400
    }

    # Expose only the Registry readiness check. Never bridge a broad public
    # prefix to Registry command routes.
    @registry_health path /health/registry
    handle @registry_health {
        rewrite * /readyz
        import upstream registry 8100
    }

    # Runtime accounting is an internal service-to-service API. Runtime calls
    # Dashboard on hatch_internal; never expose these commands at the edge.
    # Chat's service API (/v1/service/chat) is the Registry's door into the Runtime; it too stays off the edge.
    @internal_service_api path /v1/internal/access* /v1/internal/commerce* /v1/internal/deployments* /v1/service/*
    respond @internal_service_api 404

    # Packaged Desktop uses an opaque Registry bearer (issued through browser
    # sign-in at /v1/auth/desktop/*, a Dashboard route), while the browser
    # uses the Dashboard's HttpOnly cookie session. Registry owns identity.
    # Platform webhooks authenticate with their own signatures.
    @channel_webhooks path /v1/channels/*
    handle @channel_webhooks {
        import upstream registry 8100
    }
    # A WebView CORS preflight never carries the bearer itself. Route the
    # narrow Desktop endpoint preflights to the same Registry owner so the
    # browser can subsequently send the authenticated request.
    @desktop_registry_preflight {
        method OPTIONS
        path /v1/auth/me /v1/auth/logout
    }
    handle @desktop_registry_preflight {
        import upstream registry 8100
    }
    # Context Intake OAuth access tokens are Dashboard-owned opaque grants,
    # not Registry session bearers. Route only the hatch_at_ token form to the
    # Dashboard BFF; raw Desktop session tokens continue to reach Registry.
    @context_oauth_me {
        path /v1/auth/me
        header_regexp Authorization ^Bearer[[:space:]]+hatch_at_[A-Za-z0-9_-]+$
    }
    handle @context_oauth_me {
        import upstream dashboard 8500
    }
    # API keys are Registry-owned; a CLI bearer reaches Registry directly, the
    # browser (cookie, no bearer) falls through to the Dashboard proxy.
    @desktop_registry_bearer {
        path /v1/auth/me /v1/auth/logout /v1/auth/api-keys /v1/auth/api-keys/*
        header Authorization *
    }
    handle @desktop_registry_bearer {
        import upstream registry 8100
    }

    # Review pages the interview agent publishes (/form/<uuid>): opened and filled in through a signed link, no session. The Registry owns them.
    @form_pages path /form/*
    handle @form_pages {
        import upstream registry 8100
    }

    # All browser APIs belong to the cookie-backed Dashboard BFF. In
    # particular, /v1/auth/me must not be shadowed by Registry.
    handle /v1/* {
        import upstream dashboard 8500
    }

    # Static assets and all addressable public/private pages are served by the
    # Dashboard. The browser app owns auth/returnTo and private authorization.
    handle /assets/* {
        import upstream dashboard 8500
    }

    handle {
        import upstream dashboard 8500
    }
}

{$HATCH_DOMAIN} {
    import hatch_routes
}

{$HATCH_DOMAIN_ALIAS} {
    import hatch_routes
}
