  "epistemic_class": "derived_rule",
  "name": "Maya Chen signal evidence review",
  "omissions": [
    "S-SIGNAL-005",
    "S-FAQ-004",
    "S-WB-001",
    "D-RULE-006"
  ],
  "phases": [
    {
      "id": "target",
      "instruction": "State the target role interpretation in plain language, list the two or three beliefs the hiring reader needs evidence for, and note any uncertainty that could change emphasis.",
      "supports": [
        "D-RULE-001",
        "S-FAQ-003"
      ]
    },
    {
      "id": "inventory",
      "instruction": "Build an evidence ledger for the most decision-relevant claims, recording action, ownership, observable change, source, trust status, and relevance to the target.",
      "supports": [
        "D-RULE-002"
      ]
    },
    {
      "id": "triage",
      "instruction": "Reduce inflated or irrelevant claims first, prefer the smallest defensible claim, and separate publishable facts from unresolved evidence leads.",
      "supports": [
        "D-RULE-003",
        "D-RULE-005",
        "D-RULE-006"
      ]
    },
    {
      "id": "rewrite",
      "instruction": "Rewrite only after support is clear, using concrete systems, ownership, adoption, and relevance without enlarging the claim beyond the evidence.",
      "supports": [
        "D-RULE-004",
        "D-RULE-009"
      ]
    },
    {
      "id": "deliver",
      "instruction": "Return the target interpretation, evidence ledger, grounded rewrites, evidence-gap backlog, and deliberate omissions while enforcing scope boundaries.",
      "supports": [
        "D-RULE-007",
        "D-RULE-008"
      ]
    }
  ],
