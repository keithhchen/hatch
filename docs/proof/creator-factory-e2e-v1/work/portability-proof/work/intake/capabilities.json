{
  "media_behavior": "Prefer an adjacent VTT/SRT transcript; otherwise transcribe locally with Whisper when available.",
  "media_policy": "auto",
  "tools": {
    "ffmpeg": {
      "available": true,
      "path": "/opt/homebrew/bin/ffmpeg"
    },
    "ffprobe": {
      "available": true,
      "path": "/opt/homebrew/bin/ffprobe"
    },
    "pdftotext": {
      "available": true,
      "path": "/opt/homebrew/bin/pdftotext"
    },
    "whisper": {
      "available": true,
      "path": "/opt/homebrew/bin/whisper"
    }
  }
}
