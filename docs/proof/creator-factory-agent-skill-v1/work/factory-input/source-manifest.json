  "product": {
    "id": "maya-chen-resume-review",
    "name": "Signal Resume Review",
    "version": "1.0.0",
    "description": "Reads a resume and evidence in a user-selected workspace, reviews them against a chosen target role, and saves an evidence-grounded revision plan with usable rewrites.",
    "promise": "For a selected workspace containing a resume, evidence, and target role, produce and save a target interpretation, evidence ledger, defensible revision plan and rewrites, evidence-recovery questions, and deliberate omissions.",
    "boundaries": [
      "Review evidence for a target role the user has chosen; do not choose a job for the user.",
      "Do not promise interviews, offers, or any hiring outcome.",
      "Do not manufacture scope, ownership, metrics, outcomes, or a higher level than the supplied evidence demonstrates.",
      "Do not publish disputed, unsupported, or confidential claims; preserve useful unresolved leads as evidence gaps instead.",
      "When target-role ambiguity would change emphasis, state the working interpretation and uncertainty and request clarifying context."
    ],
    "price_minor": 3900,
    "currency": "USD",
    "pricing_model": "per_delivery",
    "pricing_unit": "review",
    "supported_local_capabilities": ["fs.read", "fs.write"],
    "external_tools": [],
    "presentation": {
      "format": "structured revision plan with rewrite-ready bullets"
    }
  },
