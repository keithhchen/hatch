{
  "name": "hatch-desktop-app",
  "version": "0.1.21",
  "private": true,
  "description": "Minimal Hatch Tauri desktop local runner UI",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-dmg.mjs",
    "build:distribution": "HATCH_DISTRIBUTION_BUILD=1 node scripts/build-dmg.mjs",
    "build:app": "tauri build --bundles app",
    "build:dmg:ci": "node scripts/build-dmg.mjs",
    "build:web": "vite build",
    "test:renderer": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-streamdown": "^0.3.5",
    "@hatch/ui": "file:../packages/ui",
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "vite": "^7.2.7",
    "vitest": "^3.2.4"
  }
}
