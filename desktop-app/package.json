{
  "name": "hatch-desktop-app",
  "version": "0.2.2",
  "private": true,
  "description": "Hatch Desktop: native chat client for Hatch Agents",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-dmg.mjs",
    "build:distribution": "HATCH_DISTRIBUTION_BUILD=1 node scripts/build-dmg.mjs",
    "build:app": "tauri build --bundles app",
    "build:dmg:ci": "node scripts/build-dmg.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "verify:runtime": "node scripts/verify-bundled-runtime.mjs --root src-tauri/runtime",
    "build:web": "vite build",
    "test:renderer": "vitest run"
  },
  "dependencies": {
    "@hatch/chat": "file:../packages/chat",
    "@hatch/ui": "file:../packages/ui",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "jsdom": "^29.1.1",
    "vite": "^7.2.7",
    "vitest": "^3.2.4"
  }
}
