{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hatch",
  "version": "0.2.0",
  "identifier": "dev.hatch.local",
  "build": {
    "beforeDevCommand": "npm run prepare:runtime && npm run dev:web",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build:web",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Hatch",
        "width": 760,
        "height": 600,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "acceptFirstMouse": true,
        "allowLinkPreview": false,
        "scrollBarStyle": "fluentOverlay",
        "zoomHotkeysEnabled": false,
        "devtools": false
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hatch"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "resources": {
      "runtime": "runtime",
      "locales/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "locales/zh-Hans.lproj/InfoPlist.strings": "zh-Hans.lproj/InfoPlist.strings",
      "locales/ja.lproj/InfoPlist.strings": "ja.lproj/InfoPlist.strings"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    }
  }
}
