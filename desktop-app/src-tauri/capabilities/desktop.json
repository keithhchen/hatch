{
  "$schema": "../gen/schemas/desktop-schema.json",
  "capabilities": [
    {
      "identifier": "desktop-welcome",
      "description": "The sign-in window only hands the user to the system browser and stores the session returned by the hatch:// callback.",
      "windows": ["welcome"],
      "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "core:window:allow-close",
        "allow-app-ready",
        "allow-write-auth-token",
        "allow-read-app-settings",
        "allow-open-external-url"
      ]
    },
    {
      "identifier": "desktop-main",
      "description": "The main Hatch window (the Library) may use the narrow native bridge for its own session, window settings, workspace context, and local tool lifecycle.",
      "windows": ["main"],
      "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "core:window:allow-set-size",
        "core:window:allow-set-position",
        "core:window:allow-set-title",
        "core:window:allow-set-theme",
        "core:window:allow-set-badge-count",
        "core:window:allow-request-user-attention",
        "core:window:allow-show",
        "core:window:allow-hide",
        "core:window:allow-close",
        "core:window:allow-destroy",
        "core:webview:allow-set-webview-zoom",
        "notification:default",
        "allow-app-ready",
        "allow-open-welcome-window",
        "allow-default-workspace",
        "allow-ensure-workspace",
        "allow-read-task-settings",
        "allow-read-native-drop-contexts",
        "allow-open-local-attachment",
        "allow-save-local-attachment",
        "allow-pick-native-drop-files",
        "allow-import-clipboard-attachment",
        "allow-pick-workspace-folder",
        "allow-reveal-workspace-artifact",
        "allow-open-workspace-artifact",
        "allow-request-window-attention",
        "allow-set-window-tool-context",
        "allow-clear-window-tool-context",
        "allow-execute-tool-call",
        "allow-approve-pending-tool-call",
        "allow-deny-pending-tool-call",
        "allow-cancel-tool-call",
        "allow-poll-tool-call",
        "allow-read-auth-token",
        "allow-write-auth-token",
        "allow-clear-auth-token",
        "allow-read-app-settings",
        "allow-write-app-settings",
        "allow-patch-app-settings",
        "allow-read-window-settings",
        "allow-patch-window-settings",
        "allow-open-agent-window",
        "allow-set-window-attention",
        "allow-claim-conversation-session",
        "allow-release-conversation-session",
        "allow-set-native-command-state",
        "allow-open-external-url",
        "allow-revoke-workspace-grant",
        "allow-read-product-open-links"
      ]
    },
    {
      "identifier": "desktop-agent-window",
      "description": "A dynamically created Agent Chat window receives the same window-scoped bridge; native authority still keys every grant and pending tool call by its label.",
      "windows": ["agent-*"],
      "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "core:window:allow-set-size",
        "core:window:allow-set-position",
        "core:window:allow-set-title",
        "core:window:allow-set-theme",
        "core:window:allow-set-badge-count",
        "core:window:allow-request-user-attention",
        "core:window:allow-show",
        "core:window:allow-hide",
        "core:window:allow-close",
        "core:window:allow-destroy",
        "core:webview:allow-set-webview-zoom",
        "notification:default",
        "allow-app-ready",
        "allow-open-welcome-window",
        "allow-default-workspace",
        "allow-ensure-workspace",
        "allow-read-task-settings",
        "allow-read-native-drop-contexts",
        "allow-open-local-attachment",
        "allow-save-local-attachment",
        "allow-pick-native-drop-files",
        "allow-import-clipboard-attachment",
        "allow-pick-workspace-folder",
        "allow-reveal-workspace-artifact",
        "allow-open-workspace-artifact",
        "allow-request-window-attention",
        "allow-set-window-tool-context",
        "allow-clear-window-tool-context",
        "allow-execute-tool-call",
        "allow-approve-pending-tool-call",
        "allow-deny-pending-tool-call",
        "allow-cancel-tool-call",
        "allow-poll-tool-call",
        "allow-read-auth-token",
        "allow-write-auth-token",
        "allow-clear-auth-token",
        "allow-read-app-settings",
        "allow-write-app-settings",
        "allow-patch-app-settings",
        "allow-read-window-settings",
        "allow-patch-window-settings",
        "allow-open-agent-window",
        "allow-set-window-attention",
        "allow-claim-conversation-session",
        "allow-release-conversation-session",
        "allow-set-native-command-state",
        "allow-open-external-url",
        "allow-revoke-workspace-grant",
        "allow-read-product-open-links"
      ]
    }
  ]
}
