{
  "name": "hatch-runtime-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "npm run build && node dist/index.js",
    "serve:registry": "npm run build && node dist/registryServer.js",
    "demo:consumer": "npm run build && node dist/consumerDemo.js",
    "proof:connected": "npm run build && node dist/connectedProofRunner.js",
    "uat:release": "npm run build && node dist/runtimeUatRunner.js",
    "factory:skill": "npm run build && node dist/factorySkillExecutor.js",
    "compare:blind": "npm run build && node dist/blindComparisonRunner.js",
    "dev": "node dist/index.js",
    "client": "node dist/localHarness.js",
    "start": "node dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "fflate": "^0.8.3",
    "openai": "^6.0.0",
    "pg": "^8.22.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.3",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
