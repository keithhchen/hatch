HATCH_CREATOR_MODEL=kimi-k2.6
HATCH_REVIEWER_MODEL=kimi-k2.6
HATCH_COMPACTION_MODEL=kimi-k2.6
# Immutable Creator Distillation originals, projections, LLM artifacts, and
# evaluation evidence. Production resolves credentials from HatchRuntimeRole.
HATCH_CREATOR_OBJECT_STORE_BUCKET=
HATCH_CREATOR_OBJECT_STORE_REGION=oss-cn-shanghai
HATCH_CREATOR_OBJECT_STORE_INTERNAL=true
HATCH_CREATOR_OBJECT_STORE_PREFIX=hatch
# Runtime chat uploads use a private cloud-object prefix. Leave the bucket
# empty to reuse the private Creator bucket above; production still resolves
# this to OSS and never stores chat assets in the container filesystem.
HATCH_RUNTIME_OBJECT_STORE_BUCKET=
HATCH_RUNTIME_OBJECT_STORE_REGION=oss-cn-shanghai
HATCH_RUNTIME_OBJECT_STORE_ENDPOINT=
HATCH_RUNTIME_OBJECT_STORE_INTERNAL=true
HATCH_RUNTIME_OBJECT_STORE_PREFIX=hatch/runtime-assets
# Optional regulated-deployment override. Ordinary Creator products use their
# publish-time Evals and stream their actual Kimi response to the Desktop.
# Set to `enforce` only when a deployment explicitly requires a per-delivery
# server-side claim audit, which intentionally delays visible text.
# HATCH_RUNTIME_DELIVERY_AUDIT=enforce
# Server-only configuration. Hatch Desktop never runs or connects to a local
# Runtime. The Shanghai ECS Runtime uses the VPC endpoint and its attached RAM
# role; do not configure a long-lived AccessKey.
HATCH_OUTPUT_GUARD=enforce
HATCH_OUTPUT_GUARD_REGION=cn-shanghai
HATCH_OUTPUT_GUARD_ENDPOINT=green-cip-vpc.cn-shanghai.aliyuncs.com
HATCH_OUTPUT_GUARD_SERVICE=response_security_check_pro
ALIBABA_CLOUD_ECS_METADATA=HatchRuntimeRole
ALIBABA_CLOUD_IMDSV1_DISABLE=true
# Runtime contract: all three roles use thinking=enabled and Kimi K2.6's
# provider-required temperature=1. Pi owns model context and output behavior.
PORT=8400
REGISTRY_PORT=8100
REGISTRY_HOST=127.0.0.1

# Legacy HMAC verifier for explicit local fixture/migration mode only.
# Production leaves the flag off and verifies identity through Registry sessions.
HATCH_ENABLE_LEGACY_HMAC_AUTH=false
HATCH_AUTH_SIGNING_SECRET=

# Bounded, process-local signup/signin rate limit for the single production
# Registry. Source IP is a hard request budget. Signin and signup have separate
# normalized-identity failure budgets; successful auth clears its route's
# identity failures. Rejected requests return 429 with Retry-After.
HATCH_AUTH_RATE_LIMIT_WINDOW_MS=600000
HATCH_AUTH_RATE_LIMIT_IP_MAX_ATTEMPTS=60
HATCH_AUTH_RATE_LIMIT_IDENTITY_MAX_FAILURES=10
HATCH_AUTH_RATE_LIMIT_MAX_ENTRIES=20000
# Empty by default: never trust X-Forwarded-For implicitly. Set only to the
# exact reverse-proxy IP/CIDR ranges that sanitize the forwarded header.
HATCH_AUTH_TRUSTED_PROXY_CIDRS=
# Async scrypt is protected by a process-local active/queued work bound.
HATCH_AUTH_SCRYPT_CONCURRENCY=4
HATCH_AUTH_SCRYPT_MAX_QUEUE=64
HATCH_AUTH_SESSION_RATE_LIMIT_WINDOW_MS=60000
HATCH_AUTH_SESSION_RATE_LIMIT_MAX_ATTEMPTS=600
HATCH_AUTH_SESSION_RATE_LIMIT_MAX_SOURCES=20000
HATCH_AUTH_SESSION_MAX_CONCURRENT=32
HATCH_REGISTRY_HTTP_MAX_CONCURRENT=128
HATCH_REGISTRY_HTTP_MAX_CONCURRENT_PER_SOURCE=16
HATCH_REGISTRY_HTTP_MAX_CONNECTIONS=512
HATCH_REGISTRY_HTTP_HEADERS_TIMEOUT_MS=10000
HATCH_REGISTRY_HTTP_REQUEST_TIMEOUT_MS=30000
HATCH_REGISTRY_PUBLISH_MAX_CONCURRENT=2
HATCH_REGISTRY_PUBLISH_MAX_CONCURRENT_PER_PUBLISHER=1
HATCH_REGISTRY_PUBLISH_RATE_WINDOW_MS=3600000
HATCH_REGISTRY_PUBLISH_RATE_MAX_PER_PUBLISHER=10
HATCH_REGISTRY_PUBLISH_RATE_MAX_GLOBAL=20
HATCH_REGISTRY_PUBLISH_RATE_MAX_PUBLISHERS=20000
HATCH_REGISTRY_DB_TIMEOUT_MS=5000
HATCH_REGISTRY_PUBLISH_TIMEOUT_MS=60000
HATCH_KNOWLEDGE_INDEX_REQUEST_TIMEOUT_MS=10000
HATCH_KNOWLEDGE_INDEX_MAX_RESPONSE_BYTES=4194304

# Runtime admission, transport, and dedicated Postgres bounds.
HATCH_CLIENT_TOOL_TIMEOUT_MS=300000
HATCH_RUNTIME_HELLO_TIMEOUT_MS=10000
HATCH_RUNTIME_MAX_PENDING_HELLO_AUTHORIZATIONS=8
HATCH_RUNTIME_MAX_PENDING_HELLO_AUTHORIZATIONS_PER_USER=2
HATCH_RUNTIME_MAX_PENDING_TURN_AUTHORIZATIONS=16
HATCH_RUNTIME_MAX_PENDING_TURN_AUTHORIZATIONS_PER_USER=4
HATCH_RUNTIME_MAX_ACTIVE_RUNS_PER_CONNECTION=1
HATCH_RUNTIME_MAX_ACTIVE_RUNS_GLOBAL=16
HATCH_RUNTIME_MAX_ACTIVE_RUNS_PER_USER=2
HATCH_RUNTIME_MAX_ESTABLISHED_CONNECTIONS_GLOBAL=256
HATCH_RUNTIME_MAX_ESTABLISHED_CONNECTIONS_PER_USER=8
HATCH_RUNTIME_MAX_OPEN_CONNECTIONS_GLOBAL=512
HATCH_RUNTIME_MAX_OPEN_CONNECTIONS_PER_SOURCE=16
HATCH_RUNTIME_MAX_SOCKET_BUFFERED_BYTES=8388608
HATCH_RUNTIME_CONNECTION_HEARTBEAT_MS=30000
HATCH_RUNTIME_CONNECTION_IDLE_TIMEOUT_MS=1800000
HATCH_RUNTIME_SERVER_TOOL_TIMEOUT_MS=120000
HATCH_RUNTIME_MAX_HTTP_CONNECTIONS=768
HATCH_RUNTIME_MAX_HTTP_REQUESTS_GLOBAL=64
HATCH_RUNTIME_MAX_HTTP_REQUESTS_PER_SOURCE=8
HATCH_RUNTIME_HTTP_HEADERS_TIMEOUT_MS=5000
HATCH_RUNTIME_HTTP_REQUEST_TIMEOUT_MS=10000
HATCH_RUNTIME_MAX_HTTP_RESPONSE_BYTES=8388608
HATCH_RUNTIME_DATABASE_CONNECTION_TIMEOUT_MS=5000
HATCH_RUNTIME_DATABASE_QUERY_TIMEOUT_MS=5000
HATCH_RUNTIME_DATABASE_STATEMENT_TIMEOUT_MS=5000
HATCH_RUNTIME_MAX_CONVERSATION_EVENTS=10000
HATCH_RUNTIME_MAX_CONVERSATION_BYTES=67108864
HATCH_RUNTIME_MAX_SCOPE_EVENTS=100000
HATCH_RUNTIME_MAX_SCOPE_EVENT_BYTES=268435456
HATCH_RUNTIME_MAX_GLOBAL_EVENTS=1000000
HATCH_RUNTIME_MAX_GLOBAL_EVENT_BYTES=1073741824
HATCH_RUNTIME_MAX_REPLAY_EVENTS=2000
HATCH_RUNTIME_MAX_HISTORY_BYTES=8388608

# Required for the server-side Pi Agent.
LLM_API_KEY=

# Kimi/Moonshot OpenAI-compatible endpoint. This is also the runtime fallback.
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# Runtime profile. DeepSeek is an explicit alternative when its key is set.
HATCH_LLM_PROFILE=kimi-k2.6-no-thinking

# Creator Factory profile. Kimi is the default; switching providers is an
# explicit deployment decision and never an implicit fallback.
HATCH_FACTORY_LLM_PROFILE=kimi-k2.6

# Optional: additional skill roots, separated by ":" on macOS/Linux.
HATCH_SKILL_ROOTS=

# Optional: known model context window in characters. Skills metadata uses 2% of this.
HATCH_MODEL_CONTEXT_WINDOW_CHARS=

# Hatch-owned web search gateway used by the mandatory hatch.web_search tool.
HATCH_WEB_SEARCH_PROVIDER=bocha
HATCH_WEB_SEARCH_URL=https://api.bocha.cn/v1/web-search
HATCH_WEB_SEARCH_API_KEY=

# Optional: direct override for model-visible skills metadata budget.
HATCH_SKILL_METADATA_BUDGET_CHARS=

# Optional: override the skills config path used for [[skills.config]].
HATCH_SKILLS_CONFIG=

# Optional: server-side MCP endpoints exposed as mcp_call. Keep credentials server-side.
# Example: {"docs":{"url":"https://example.com/mcp","headers":{"Authorization":"Bearer token"}}}
HATCH_MCP_SERVERS=

# Registry Control Plane used to resolve creator HTTP/MCP tools. The Runtime
# never accepts connection URLs or credentials directly.
HATCH_REGISTRY_URL=http://127.0.0.1:8100
HATCH_REGISTRY_RUNTIME_SERVICE_TOKEN=
# Shared only by the Registry and Dashboard commerce service. Browser/user
# bearer tokens can never call the entitlement mutation route directly.
HATCH_REGISTRY_COMMERCE_SERVICE_TOKEN=
# Bounds Registry identity/entitlement verification, including response body.
HATCH_REGISTRY_AUTH_TIMEOUT_MS=5000

# Runtime cache only. The content authority is the live Registry release and
# its immutable OSS runtime manifest; this directory is rebuilt as needed.
# Publish-time shared Runtime Corpus volume. Registry writes; Runtime reads.
HATCH_RUNTIME_CORPUS_ROOT=

# Access projection used by the Desktop consumer flow. A published Corpus is
# runtime-available; a consumer still needs an active entitlement/access token.
HATCH_ENTITLEMENTS_FILE=

# Self-hosted RAG. Qdrant is the only vector store; the Corpus never carries
# these provider details. Runtime uses hatch.file_search on demand.
HATCH_QDRANT_URL=http://127.0.0.1:6333
HATCH_QDRANT_API_KEY=
HATCH_QDRANT_COLLECTION=hatch_knowledge_text_v4_1024
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
