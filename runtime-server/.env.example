HATCH_CREATOR_MODEL=kimi-k2.6
HATCH_REVIEWER_MODEL=kimi-k2.6
HATCH_COMPACTION_MODEL=kimi-k2.6
# Optional regulated-deployment override. Ordinary Creator products use their
# publish-time Evals and stream their actual Kimi response to the Desktop.
# Set to `enforce` only when a deployment explicitly requires a per-delivery
# server-side claim audit, which intentionally delays visible text.
# HATCH_RUNTIME_DELIVERY_AUDIT=enforce
# Runtime contract: all three roles use thinking=disabled and temperature=1
# (the value currently accepted by Kimi K2.6).
# These controls are fixed in code rather than configurable per environment.
PORT=8400
REGISTRY_PORT=8100
REGISTRY_HOST=127.0.0.1

# Shared with Platform Registry. The Desktop never receives this secret.
HATCH_AUTH_SIGNING_SECRET=

# Required for server-side Chat Completions.
MOONSHOT_API_KEY=

# Kimi/Moonshot OpenAI-compatible endpoint. This is also the runtime fallback.
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# Optional: additional skill roots, separated by ":" on macOS/Linux.
HATCH_SKILL_ROOTS=

# Optional: known model context window in characters. Skills metadata uses 2% of this.
HATCH_MODEL_CONTEXT_WINDOW_CHARS=

# Optional: known model context window in tokens. Auto compaction uses 90% of this.
HATCH_MODEL_CONTEXT_WINDOW_TOKENS=256000

# Optional: direct override for the auto-compaction trigger threshold.
HATCH_AUTO_COMPACT_LIMIT_TOKENS=

# Hatch-owned web search gateway used by the mandatory hatch.web_search tool.
HATCH_WEB_SEARCH_PROVIDER=bocha
HATCH_WEB_SEARCH_URL=https://api.bocha.cn/v1/web-search
HATCH_WEB_SEARCH_API_KEY=

# Optional: direct override for model-visible skills metadata budget.
HATCH_SKILL_METADATA_BUDGET_CHARS=

# Optional: override the skills config path used for [[skills.config]].
HATCH_SKILLS_CONFIG=

# Optional: server-side MCP endpoints exposed as mcp_call. Keep credentials server-side.
# Example: {"docs":{"url":"https://example.com/mcp","headers":{"Authorization":"Bearer token"}}}
HATCH_MCP_SERVERS=

# Registry Control Plane used to resolve creator HTTP/MCP tools. The Runtime
# never accepts connection URLs or credentials directly.
HATCH_REGISTRY_URL=http://127.0.0.1:8100
HATCH_REGISTRY_RUNTIME_SERVICE_TOKEN=

# Current Agent Corpus storage installed by Registry. Runtime resolves
# <creator_id>/<agent_id> from this read-only root.
HATCH_AGENT_CORPUS_ROOT=

# Access projection used by the Desktop consumer flow. A published Corpus is
# runtime-available; a consumer still needs an active entitlement/access token.
HATCH_ENTITLEMENTS_FILE=

# Self-hosted RAG. Qdrant is the only vector store; the Corpus never carries
# these provider details. Runtime uses file_search on demand.
HATCH_QDRANT_URL=http://127.0.0.1:6333
HATCH_QDRANT_API_KEY=
HATCH_QDRANT_COLLECTION=hatch_knowledge_text_v4_1024
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
