{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hatch-ingest task.json",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "kind", "url"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
              "kind": { "const": "link" },
              "url": { "type": "string", "format": "uri" }
            }
          },
          {
            "type": "object",
            "required": ["id", "kind", "name", "download_url"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
              "kind": { "const": "file" },
              "name": { "type": "string", "description": "Display name; its extension decides the converter." },
              "bytes": { "type": "integer", "description": "Expected size; the download fails on mismatch." },
              "sha256": { "type": "string", "description": "Expected digest; the download fails on mismatch." },
              "download_url": { "type": "string", "format": "uri", "description": "Short-lived presigned GET of the original. Never print it." }
            }
          }
        ]
      }
    },
    "context": { "type": "string", "description": "Free text: whose content, which product." }
  }
}
