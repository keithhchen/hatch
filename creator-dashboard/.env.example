# Public OSS prefix containing desktop/latest/mac/apple-silicon.dmg and
# desktop/latest/mac/intel.dmg.
VITE_HATCH_DESKTOP_DOWNLOAD_BASE_URL=https://your-bucket.oss-cn-shanghai.aliyuncs.com/desktop/latest
